# Stage 1: Build the React app (Vite) FROM node:18-alpine AS builder WORKDIR /app # Copy package.json and package-lock.json (if available) COPY package.json ./ # Try to copy lock file if it exists, otherwise it's fine COPY package-lock.json* ./ 2>/dev/null || true RUN npm install --legacy-peer-deps COPY . . # Set build-time environment variables if needed (e.g., for API base URL) # ARG VITE_API_BASE_URL=/api # ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} RUN npm run build # Stage 2: Serve the built app with Nginx FROM nginx:1.25-alpine WORKDIR /usr/share/nginx/html RUN rm -rf ./* COPY --from=builder /app/dist . # Create a basic Nginx configuration for SPA routing: RUN echo 'server {     listen 80;     server_name localhost;     root /usr/share/nginx/html;     index index.html;     location / {         try_files $uri $uri/ /index.html;     } }' > /etc/nginx/conf.d/default.conf EXPOSE 80 CMD ["nginx", "-g", "daemon off;"]
